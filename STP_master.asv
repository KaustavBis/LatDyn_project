% =========================================================================
% MASTER SIMULATION & TELEMETRY SCRIPT: STEERING PULSE (STP)
% Models: STP_1a (Dual Motor / TV) vs STP_1b (Single Motor / Brake Vec)
% Target: Free-Response Natural Frequency Extraction (Base-MATLAB)
% =========================================================================
clear; clc; close all;

%% 1. INITIALIZATION & SIMULATION
disp('====================================================');
disp('   STEERING PULSE (STP) - NATURAL FREQ EXTRACTION   ');
disp('====================================================');

% init_stp; 
disp('-> Running Dual Motor TV Simulation (STP_1a)...');
out_a = sim('STP_1a', 'ReturnWorkspaceOutputs', 'on');
save('temp_out_a.mat', 'out_a'); 

disp('-> Running Single Motor Simulation (STP_1b)...');
out_b = sim('STP_1b', 'ReturnWorkspaceOutputs', 'on');
load('temp_out_a.mat'); delete('temp_out_a.mat'); 

%% 2. DATA EXTRACTION: TIME DOMAIN
disp('-> Extracting Telemetry Data...');
t_a = out_a.tout; t_b = out_b.tout;
dt = mean(diff(t_a)); Fs = 1/dt; 

delta_a_raw = squeeze(out_a.delta_a.Data) * (180/pi);
delta_b_raw = squeeze(out_b.delta_b.Data) * (180/pi);
r_a_raw = squeeze(out_a.r_curr_a.Data) * (180/pi);
r_b_raw = squeeze(out_b.r_curr_b.Data) * (180/pi);

% Extract Yaw Rate Demand (Target) from the LQR Reference Model
r_ref_deg = squeeze(out_a.r_ref_a.Data) * (180/pi); 

vx_a = squeeze(out_a.vx_curr_a.Data); 
vx_b = squeeze(out_b.vx_curr_b.Data);

Trr_m_a = squeeze(out_a.Trr_m_a.Data); 
Trl_m_a = squeeze(out_a.Trl_m_a.Data);

%% 3. ISOLATE FREE-RESPONSE REGION & CALCULATE FFT
disp('-> Analyzing Ring-Down Oscillation...');

% Isolate telemetry strictly AFTER the steering pulse has ended (15.4s)
% We start at 15.5s to observe the raw unforced response of the chassis.
t_eval_start = 15.5; 
idx_a = (t_a >= t_eval_start);
idx_b = (t_b >= t_eval_start);

r_ring_a = r_a_raw(idx_a);
r_ring_b = r_b_raw(idx_b);

% Base-MATLAB Hamming Window Generator 
calc_hamming = @(N) 0.54 - 0.46 * cos(2*pi*(0:N-1)' / (N-1));

% Detrend to remove DC offset, window to smooth edges for a clean FFT
r_ring_a = detrend(r_ring_a(:)) .* calc_hamming(length(r_ring_a));
r_ring_b = detrend(r_ring_b(:)) .* calc_hamming(length(r_ring_b));

% FFT Math
L_a = length(r_ring_a); L_b = length(r_ring_b);
f_a = Fs * (0:(L_a/2))/L_a;
f_b = Fs * (0:(L_b/2))/L_b;

Y_a = fft(r_ring_a); Mag_a = abs(Y_a(1:floor(L_a/2)+1));
Y_b = fft(r_ring_b); Mag_b = abs(Y_b(1:floor(L_b/2)+1));

% Restrict the search to realistic chassis frequencies (0.5 to 5.0 Hz)
valid_idx_a = find(f_a >= 0.5 & f_a <= 5.0);
valid_idx_b = find(f_b >= 0.5 & f_b <= 5.0);

[~, max_idx_a] = max(Mag_a(valid_idx_a));
nat_freq_a_hz = f_a(valid_idx_a(max_idx_a));

[~, max_idx_b] = max(Mag_b(valid_idx_b));
nat_freq_b_hz = f_b(valid_idx_b(max_idx_b));

% --- Explicitly Output to Workspace & Terminal ---
assignin('base', 'STP_NatFreq_DualMotor_Hz', nat_freq_a_hz);
assignin('base', 'STP_NatFreq_SingleMotor_Hz', nat_freq_b_hz);

disp('====================================================');
disp('   EXTRACTED NATURAL FREQUENCIES');
disp('====================================================');
fprintf('-> Dual Motor TV:   %.2f Hz\n', nat_freq_a_hz);
fprintf('-> Single Motor:    %.2f Hz\n', nat_freq_b_hz);

%% 4. PLOTTING
disp('====================================================');
disp('-> Rendering Dashboards...');

% =========================================================================
% FIG 1: FULL TIME DOMAIN VERIFICATION
% =========================================================================
figure('Name', 'Fig 1: Steering Pulse Time Domain', 'Color', 'w', 'Position', [50, 50, 1000, 800]);

subplot(2,1,1);
plot(t_a, vx_a * 3.6, 'b-', 'LineWidth', 1.5); hold on; grid on; plot(t_b, vx_b * 3.6, 'r-', 'LineWidth', 1.5);
title('Longitudinal Velocity (Settling Phase Verification)'); ylabel('Speed (km/h)');
legend('Dual Motor TV', 'Single Motor', 'Location', 'best'); xlim([0 t_a(end)]);

subplot(2,1,2);
yyaxis left; 
plot(t_a, delta_a_raw, 'k-', 'LineWidth', 1.5); 
ylabel('Steering Input (deg)');

yyaxis right; 
plot(t_a, r_ref_deg, 'k--', 'LineWidth', 1.5); hold on; % Superimposed Demand
plot(t_a, r_a_raw, 'b-', 'LineWidth', 1.5); 
plot(t_b, r_b_raw, 'r-', 'LineWidth', 1.5);
ylabel('Yaw Rate (deg/s)'); title('Pulse Response (Demand vs Actual Recovery)');
legend('Steering Input', 'Yaw Rate Demand (Ref)', 'Dual Motor TV', 'Single Motor', 'Location', 'best');
xlim([14 20]); grid on; % Zoomed tightly around the pulse

% =========================================================================
% FIG 2: FREE-RESPONSE FFT SPECTRUM
% =========================================================================
figure('Name', 'Fig 2: Ring-Down Frequency Spectrum', 'Color', 'w', 'Position', [100, 100, 900, 600]);

plot(f_a, Mag_a, 'b-', 'LineWidth', 2); hold on; grid on;
plot(f_b, Mag_b, 'r-', 'LineWidth', 2);
xline(nat_freq_a_hz, 'b--', sprintf('Dual Motor: %.2f Hz', nat_freq_a_hz), 'LabelVerticalAlignment', 'top', 'LineWidth', 1.5);
xline(nat_freq_b_hz, 'r--', sprintf('Single Motor: %.2f Hz', nat_freq_b_hz), 'LabelVerticalAlignment', 'bottom', 'LineWidth', 1.5);

title('Yaw Rate Spectrum (Free-Response Phase Only)');
xlabel('Frequency (Hz)'); ylabel('Magnitude (FFT of Yaw Rate)');
legend('Dual Motor TV', 'Single Motor', 'Location', 'northeast');
xlim([0 5]); % Zoom in on the relevant vehicle dynamics spectrum

% =========================================================================
% FIG 3: TV CONTROL INTENT (PULSE DISTURBANCE)
% =========================================================================
Delta_T_a = Trr_m_a - Trl_m_a; 
figure('Name', 'Fig 3: Torque Vectoring Intent Analysis', 'Color', 'w', 'Position', [150, 150, 1000, 600]);

subplot(2,1,1);
plot(t_a, Trr_m_a, 'b-', 'LineWidth', 1); hold on; grid on;
plot(t_a, Trl_m_a, 'g-', 'LineWidth', 1);
ylabel('Motor Torque (Nm)'); title('Actuator Shock Response');
legend('Rear Right', 'Rear Left', 'Location', 'northeast'); xlim([14 20]);

subplot(2,1,2);
yyaxis left; plot(t_a, delta_a_raw, 'k--', 'LineWidth', 1.5); ylabel('Steering Input (deg)');
yyaxis right; plot(t_a, Delta_T_a, 'm-', 'LineWidth', 1.5); ylabel('\Delta Torque [Nm]');
title('TV Intent: Instantaneous Stabilizing Counter-Moment');
legend('Steering Input', '\Delta Torque (Applied Yaw Moment)', 'Location', 'southwest');
xlim([14 20]); grid on; xlabel('Time (s)');

%% 5. MIMURO PLOT DATA EXTRACTION (INJECT INTO MAT FILE)
disp('====================================================');
disp('-> Extracting Mimuro Natural Frequency Parameters...');

mat_filename = 'Mimuro_Data.mat';
if isfile(mat_filename); load(mat_filename, 'Mimuro'); else; Mimuro = struct(); end

% Injecting into the 'SWS' namespace so the plotting script works automatically
Mimuro.Dual_Motor.SWS.Natural_Freq_Hz = nat_freq_a_hz;
Mimuro.Single_Motor.SWS.Natural_Freq_Hz = nat_freq_b_hz;

save(mat_filename, 'Mimuro');
disp(['-> Natural Frequency parameters saved successfully to ', mat_filename]);
disp('====================================================');
disp('-> Steering Pulse (STP) Execution Complete.');